{
    "name": "jason/captcha",
    "type": "package",
    "description": "Laravel 10/11/12/13 Captcha Package",
    "keywords": [
        "laravel Captcha",
        "laravel Security",
        "Captcha"
    ],
    "homepage": "https://github.com/jasonencode/captcha",
    "license": "MIT",
    "authors": [
        {
            "name": "Jason.Chen",
            "email": "chenjxlg@gmail.com",
            "homepage": "https://github.com/jasonencode",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "laravel/framework": "^12.0|^13.0",
        "intervention/image": "^4.1"
    },
        "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Jason\\Captcha\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jason\\Captcha\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Jason\\Captcha\\CaptchaServiceProvider"
            ],
            "aliases": {
                "Captcha": "Jason\\Captcha\\Facades\\Captcha"
            }
        }
    }
}
